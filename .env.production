# ============================================
# DevFlow Agent — Production Environment
# 使用方式: cp .env.production .env && ./deploy.sh
# ============================================

# ---------- DeepSeek / OpenAI API（必填）----------
OPENAI_API_KEY=sk-your-deepseek-or-openai-api-key
# API 地址: DeepSeek 或 OpenAI 兼容接口
OPENAI_BASE_URL=https://api.deepseek.com
# 模型名: deepseek-chat / deepseek-coder / gpt-4o 等
OPENAI_MODEL=deepseek-chat

# ---------- GitHub（必填）----------
GITHUB_TOKEN=ghp_your_github_personal_access_token
# Webhook HMAC-SHA256 密钥（与 GitHub Webhook 设置一致）
GITHUB_WEBHOOK_SECRET=generate-a-random-secret-here

# ---------- 登录密码（必填 — 请生成强随机密码）----------
# 提示: openssl rand -base64 24
DEVFLOW_ADMIN_PASSWORD=PLACEHOLDER_GENERATE_STRONG_PASSWORD
DEVFLOW_OPERATOR_PASSWORD=PLACEHOLDER_GENERATE_STRONG_PASSWORD

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=PLACEHOLDER_GENERATE_STRONG_PASSWORD
MYSQL_USER=devflow
MYSQL_PASSWORD=PLACEHOLDER_GENERATE_STRONG_PASSWORD
DB_URL=jdbc:mysql://mysql:3306/devflow_agent?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false
DB_USERNAME=devflow
# DB_PASSWORD 必须与 MYSQL_PASSWORD 相同
DB_PASSWORD=PLACEHOLDER_GENERATE_STRONG_PASSWORD

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=PLACEHOLDER_GENERATE_STRONG_PASSWORD

# ---------- RabbitMQ ----------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=devflow
RABBITMQ_PASSWORD=PLACEHOLDER_GENERATE_STRONG_PASSWORD
RABBITMQ_DEFAULT_USER=devflow
RABBITMQ_DEFAULT_PASS=PLACEHOLDER_GENERATE_STRONG_PASSWORD

# ---------- pgvector（RAG 向量存储，目前可选）----------
POSTGRES_USER=devflow
POSTGRES_PASSWORD=PLACEHOLDER_GENERATE_STRONG_PASSWORD

# ---------- Spring Profile ----------
SPRING_PROFILES_ACTIVE=docker

# ---------- JVM 参数（可选）----------
# 默认 -Xmx1g（适合 8G 服务器）。小机器建议:
#   4G 服务器: JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC -Djdk.httpclient.connectionPoolSize=20"
#   2G 服务器: 跑不了，别试
# 不设置则使用 Dockerfile 默认值
# JAVA_OPTS=
